# Variables de entorno de Mudanzas Cano
# Copia este archivo como ".env" para desarrollo local
# y configura estas mismas variables en Vercel (Project → Settings → Environment Variables)

# --- Clerk (autenticación; se usan claves de prueba, el sitio público no la requiere) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_aW1tb3J0YWwtc2hyZXctNjEuY2xlcmsuYWNjb3VudHMuZGV2JA
CLERK_SECRET_KEY=sk_test_92piofr3KQAipCQnLBBmxsiZP9zv9aNk6GPwnQplzF

# --- URL pública del sitio (cámbiala por tu dominio final) ---
NEXT_PUBLIC_APP_URL=https://mudanzascano.com.mx

# --- Base de datos (el landing no la usa; valor de relleno para pasar la validación) ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# --- Ajustes de Next.js ---
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_SENTRY_DISABLED=true
NEXT_PUBLIC_LOGGING_LEVEL=info
